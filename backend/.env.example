APP_NAME=Totem Ingresso API
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=totem_ingresso
DATABASE_USER=totem
DATABASE_PASSWORD=troque-esta-senha
# Em produção, use uma chave Fernet independente. Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CPF_ENCRYPTION_KEY=
DATABASE_ECHO=false
FRONTEND_ORIGINS=http://localhost:5173
RESERVATION_MINUTES=10
IDEMPOTENCY_TTL_HOURS=24
OPERATION_LOCK_SECONDS=30
REQUEST_TIMEOUT_SECONDS=15
MAX_REQUEST_BYTES=65536
PAYMENT_TIMEOUT_SECONDS=5
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30
LOG_LEVEL=INFO
